  <body>
    <outline text="Payloads" title="Payloads">
      <outline text="etaHEN" title="etaHEN" type="rss" xmlUrl="https://github.com/etaHEN/etaHEN" description="Le Homebrew Enabler (HEN) de référence pour la PS5 avec serveurs de triche, plugins et gestionnaire de mémoire intégrés."/>
      <outline text="PS5 Unified Autoloader" title="PS5 Unified Autoloader" type="rss" xmlUrl="https://github.com/itsPLK/ps5-unified-autoloader" description="Chargeur universel de payloads permettant de lancer automatiquement vos outils favoris au démarrage de l'exploit."/>
      <outline text="PS5 Payload Manager" title="PS5 Payload Manager" type="rss" xmlUrl="https://github.com/itsPLK/ps5-payload-manager" description="Interface d'administration et de gestion réseau pour envoyer, activer et ordonner vos fichiers ELF/BIN sur la console."/>
      <outline text="ELF Arsenal" title="ELF Arsenal" type="rss" xmlUrl="https://git.etawen.dev/soniciso/elf-arsenal" description="Boîte à outils regroupant une collection complète de payloads utilitaires pour les consoles jailbreakées."/>
      <outline text="Kura" title="Kura" type="rss" xmlUrl="https://github.com/NookieAI/kura" description="Un loader de payloads moderne et épuré conçu pour optimiser l'injection de code sur PS5."/>
      <outline text="PIZZA-HEN" title="PIZZA-HEN" type="rss" xmlUrl="https://github.com/Michele-M-Media/PIZZA-HEN" description="PIZZA HEN is an experimental all-in-one PS5 homebrew environment."/>
      <outline text="onionHEN" title="onionHEN" type="rss" xmlUrl="https://github.com/aydencharles/onionHEN" description="An all-in-one HEN and Toolbox for PlayStation 5."/>
      <outline text="etaHEN-Beta" title="etaHEN-Beta" type="rss" xmlUrl="https://github.com/zecoxao/zecoxao.github.io/raw/refs/heads/main/luasauce/payloads/etaHEN-2.6B.bin" description="etahen beta version experimental."/>
      <outline text="ProsperoMgr" title="ProsperoMgr" type="rss" xmlUrl="https://github.com/notmaj0r/ProsperoMgr" description="A Web-Based All-In-One homebrew manager for your PlayStation 5"/>
